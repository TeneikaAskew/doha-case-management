# Copy to .env (gitignored) and fill in. See src/accessControl.js.

# Shared access codes for the demo, used by e2e tests to sign in (plaintext
# stays local; only hashes may ship)
DEMO_ACCESS_PASSWORD=
DEMO_ACCESS_PASSWORD_2=

# Comma-separated SHA-256 hex of the access codes; baked into the client bundle
# at build time. Compute:
# python -c "import hashlib;print(hashlib.sha256(b'<pw>').hexdigest())"
VITE_ACCESS_PASSWORD_HASHES=
