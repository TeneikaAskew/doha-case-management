# Copy to .env (gitignored) and fill in. See src/accessControl.js.

# Shared access password for the demo, used by e2e tests to sign in (plaintext
# stays local; only its hash may ship)
DEMO_ACCESS_PASSWORD=

# SHA-256 hex of DEMO_ACCESS_PASSWORD; baked into the client bundle at build
# time. Compute: python -c "import hashlib;print(hashlib.sha256(b'<pw>').hexdigest())"
VITE_ACCESS_PASSWORD_HASH=
