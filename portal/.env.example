# Copy to .env (gitignored) and fill in. See src/accessControl.js.

# Shared access codes for the demo, used by e2e tests to sign in (plaintext
# stays local; only hashes may ship)
DEMO_ACCESS_PASSWORD=
DEMO_ACCESS_PASSWORD_2=

# Comma-separated SHA-256 hex of the access codes; baked into the client bundle
# at build time. Compute:
# python -c "import hashlib;print(hashlib.sha256(b'<pw>').hexdigest())"
VITE_ACCESS_PASSWORD_HASHES=

# "Ask the Case" tab: same Google API key as the sead4_llm analyzer
# (GOOGLE_API_KEY). CI injects it from the GOOGLE_API_KEY repo secret, which
# bakes it into the public bundle BY DESIGN (demo) - the key must carry a
# website restriction (this Pages origin), an API restriction (Generative
# Language API only), and a low quota cap in Google Cloud. Without a key,
# answers compose from local retrieval ("Simulated retrieval").
VITE_GEMINI_API_KEY=
